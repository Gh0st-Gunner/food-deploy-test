# Vietnamese Food Classifier API — Environment Variables
# Copy this to .env and fill in your values

# API
VNFOOD_API_HOST=0.0.0.0
VNFOOD_API_PORT=10800

# PostgreSQL
VNFOOD_DATABASE_URL=postgresql://vnfood:vnfood@localhost:5432/vnfood

# Redis
VNFOOD_REDIS_HOST=localhost
VNFOOD_REDIS_PORT=6379
VNFOOD_REDIS_DB=0
VNFOOD_REDIS_PASSWORD=

# Celery
VNFOOD_CELERY_BROKER_URL=redis://localhost:6379/0
VNFOOD_CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO
VNFOOD_S3_ENDPOINT=http://localhost:9000
VNFOOD_S3_ACCESS_KEY=minioadmin
VNFOOD_S3_SECRET_KEY=minioadmin
VNFOOD_S3_BUCKET=vn-food-images

# API Keys
VNFOOD_USDA_API_KEY=
VNFOOD_FATSECRET_CLIENT_ID=
VNFOOD_FATSECRET_CLIENT_SECRET=

# Models
VNFOOD_MODELS_DIR=models